{
  "name": "class-notice-board-classroom",
  "version": "1.0.3",
  "description": "班级通知屏 · 教室端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "release": "npm version patch && electron-builder --win --x64",
    "release:mac": "npm version patch --no-git-tag-version && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "xyz.wongpitt.cnb.classroom",
    "productName": "班级通知屏",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-v${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
      "icon": "assets/icon.png",
      "artifactName": "${productName}-v${version}-mac-${arch}.dmg",
      "category": "public.app-category.education"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "window": { "width": 540, "height": 380 }
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "assets/**",
      "node_modules/**"
    ]
  }
}
