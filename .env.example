# 复制为 .env 后修改
# 生成密钥： openssl rand -hex 32
CNB_TOKEN_SECRET=请替换为随机字符串
CNB_INVITE_CODE=SCHOOL2026
CNB_LOG_LEVEL=info

# 管理员账号配置
# CNB_ADMIN_USERNAME：用于识别哪个账号是管理员（与下方 INIT 保持一致）
# CNB_INIT_ADMIN_* ：首次启动时若账号不存在则自动创建，之后不再重复创建
CNB_ADMIN_USERNAME=admin
CNB_INIT_ADMIN_USERNAME=admin
CNB_INIT_ADMIN_PASSWORD=Admin@123
CNB_INIT_ADMIN_DISPLAY_NAME=管理员
